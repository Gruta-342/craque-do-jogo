{
  "name": "craque-do-jogo",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @craque/web",
    "dev:mobile": "npm run start --workspace @craque/mobile",
