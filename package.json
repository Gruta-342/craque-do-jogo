    "typecheck": "turbo run typecheck",
    "test:engine": "npm run test --workspace @craque/game-engine"
  },
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  },
  "engines": { "node": ">=22.13.0" }
}
